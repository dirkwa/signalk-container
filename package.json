{
  "name": "signalk-container",
  "version": "2.0.0-beta.1",
  "description": "Shared container runtime management (Podman/Docker) for Signal K plugins",
  "keywords": [
    "signalk-node-server-plugin",
    "signalk-plugin-configurator"
  ],
  "signalk": {
    "displayName": "Container Manager",
    "appIcon": "./icon.svg"
  },
  "signalk-plugin-enabled-by-default": true,
  "type": "module",
  "main": "dist/index.cjs",
  "scripts": {
    "build:server": "tsc && node tools/finalize-cjs.mjs",
    "build:configpanel": "vite build",
    "build": "npm run build:server && npm run build:configpanel",
    "watch": "tsc --watch",
    "prettier": "prettier --write .",
    "lint": "eslint --fix",
    "format": "npm run prettier && npm run lint",
    "ci-lint": "eslint && prettier --check .",
    "test": "node --test \"dist/test/**/*.test.cjs\"",
    "build:all": "npm run build && npm test",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "author": "Dirk Wahrheit <dirkwahrheit@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dirkwa/signalk-container"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@module-federation/vite": "^1.5.0",
    "@signalk/server-api": "latest",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.4.0",
    "prettier": "^3.8.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.58.0",
    "vite": "^7.1.0"
  }
}
