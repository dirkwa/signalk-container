node_modules/
dist/
# Webpack / vite / module-federation build output.  Nothing under
# public/ is tracked in this repo — the whole tree is generated.
# Cover *.js / *.txt / chunks/ / remoteEntry.js / etc. with a single
# directory rule.
public/
*.tsbuildinfo
.DS_Store
*.log
package-lock.json
# Module Federation diagnostics (generated by webpack at build time;
# contains dev-machine paths and timestamps).
.mf/
# Local CodeRabbit review output — see AGENTS.md "Pre-PR checklist".
cr-review*
cr-audit*
# Disk-backed scratch dir for local spikes (not /tmp — that's RAM on trixie).
.scratch/

# node --test JUnit report; CI uploads it as an artifact
test-results/
